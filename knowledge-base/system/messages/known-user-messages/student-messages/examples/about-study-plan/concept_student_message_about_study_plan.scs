// ====================================================================
// DAY 7 — Практикум формализации и экосистема
// ====================================================================

@study_day_7_reply_template = [📅 <b>День 7: Практикум формализации и экосистема</b>

<b>🎯 Цель дня:</b>
Собрать все знания воедино, понять правила трансляции и познакомиться с инструментарием разработчика.

<b>📖 Изучаемые компоненты:</b>
• <b>Правила построения идентификаторов</b>
• <b>Системные sc-идентификаторы</b>
• <b>Экосистема OSTIS</b> — репозитории и инструменты

<b>🔬 Теоретический и практический фокус:</b>

<b>1. Правила построения идентификаторов:</b>
• Определяют допустимые символы
• Определяют структуру идентификаторов
• Системные идентификаторы: без пробелов, на английском

<b>2. Правила перевода между формами:</b>
• SCg → SCs: граф → текст
• SCs → SCn: текст → гипертекст
• Любая форма может быть транслирована в любую другую

<b>3. Стек технологий OSTIS:</b>
• <b>OSTIS Standard</b> — стандарт технологии
• <b>OSTIS Metasystem</b> — метасистема
• <b>OSTIS Platform</b>:
  - sc-memory (программная реализация памяти)
  - Python API клиент
  - TypeScript API клиент
  - scp-machine
  - Интерпретатор интерфейсов
  - Компонентный менеджер
• <b>Редактор БЗ</b> и <b>плагин для VS Code</b>

<b>4. Итоговое упражнение:</b>
Декомпозиция небольшой предметной области:
• Выделить узлы (понятия)
• Связать их дугами принадлежности
• Присвоить идентификаторы

💡 <i>Поздравляю с завершением интенсива! Ты готов к работе с OSTIS и SC-кодом! 🚀</i>];;

@if_study_day_7_production = {
    rrel_reply_template: {
        rrel_message_template: @study_day_7_reply_template;
        rrel_message_class: concept_system_reply_message;
        rrel_expected_user_reply_message_classes: {
            {
                rrel_reply_message_class: concept_student_message_about_searching_studied_disciplines;
                rrel_context_message_class: concept_student_message_about_searching_discipline_information
            }
        }
    }
};;
@if_study_day_7_production <- nrel_reply_production;;

concept_student_message_about_study_plan_day7
<- sc_node_class;
=> nrel_main_idtf:
    [класс сообщений учащихся о запросе Дня 7 учебного плана]
    (*
        <- lang_ru;;
    *);
<- concept_message_topic;
<= nrel_inclusion:
    concept_student_message;
=> nrel_corresponding_skill:
    ...
    (*
        => nrel_main_idtf:
            [показать День 7 учебного плана]
            (*
                <- lang_ru;;
            *);;
        <- concept_skill;;
    *);
=> nrel_example:
    [День 7]
    (*
        <- concept_example;;
    *);
=> nrel_reply_production_chain: <
    @if_study_day_7_production
>;
=> nrel_message_keywords: [
    день 7;
    день седьмой;
    седьмой день;
    7 день;
    day 7
];;
