// -- Производство для неизвестного сообщения

@unknown_reply = [Извини, я пока не знаю, как на это ответить.

Попробуй переформулировать вопрос или уточнить детали — я всегда готов помочь!];;

@if_unknown_production = {
    rrel_reply_template: {
        rrel_message_template: @unknown_reply
    }
};;
@if_unknown_production <- nrel_reply_production;;

// -- Класс неизвестных сообщений

concept_unknown_message
<- sc_node_class;
=> nrel_main_idtf:
    [класс неизвестных сообщений]
    (*
        <- lang_ru;;
    *);
<- concept_message_topic;
<= nrel_inclusion:
    concept_message;
=> nrel_reply_production_chain: <
    @if_unknown_production
>;;
