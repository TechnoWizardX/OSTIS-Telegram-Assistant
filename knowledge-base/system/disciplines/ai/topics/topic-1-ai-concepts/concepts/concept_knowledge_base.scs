<- sc_node_class;
<- concept;
<- concept_class;
=> nrel_definition:
    [База знаний - компонент интеллектуальной системы, хранящий формализованные знания, используемые системой в процессе вывода и рассуждения.]
    (*
        <- concept_definition;;
    *);
=> nrel_explanation:
    [База знаний содержит факты, правила и модели предметной области, структурированные так, чтобы система могла их интерпретировать и использовать для логического вывода.]
    (*
        <- concept_explanation;;
    *);;
