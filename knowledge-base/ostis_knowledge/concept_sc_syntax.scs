nrel_incidence
<- sc_node_non_role_relation;
<- concept_non_role_relation;
<- concept_binary_relation;
=> nrel_main_idtf:
    [отношение инцидентности обозначений sc-пар с их элементами]
    (*
        <- lang_ru;;
    *);
=> nrel_definition:
    [Бинарное ориентированное отношение инцидентности, заданное на множестве всех sc-элементов, связывающее обозначения sc-пар с их элементами. Является первым из двух отношений инцидентности, определяющих синтаксис SC-кода.]
    (*
        <- concept_definition;;
        <- lang_ru;;
    *);
<= nrel_inclusion: concept_sc_syntax;;

