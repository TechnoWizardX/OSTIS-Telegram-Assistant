concept_ostis
<- sc_node_class;
<- concept;
=> nrel_main_idtf:
    [OSTIS — Open Semantic Technology for Intelligent Systems];
    (*
        <- lang_ru;;
    *);
=> nrel_definition:
    [OSTIS — это технология с открытым исходным кодом для совместимых интеллектуальных систем нового поколения.];
    (*
        <- concept_definition;;
        <- lang_ru;;
    *);
=> nrel_explanation:
    [OSTIS обеспечивает интеграцию различных типов знаний, моделей решения проблем и интеллектуальных интерфейсов, что позволяет создавать семантически совместимые интеллектуальные системы.];
    (*
        <- concept_explanation;;
        <- lang_ru;;
    *);
=> nrel_rationale:
    {
        [Интеллектуальная система — это система, которая может легко научиться решать новые задачи без значительных затрат.];
        [Для создания интеллектуальной системы необходимо интегрировать различные типы знаний и различные модели решения проблем, а также использовать интеллектуальные интерфейсы.];
        [OSTIS решает проблему совместимости интеллектуальных систем, обеспечивая платформенную независимость и рефлексивность.];
    };
=> nrel_principles:
    {
        [SC-код — универсальный способ представления информации, основанный на теории множеств и теории графов.];
        [SC-код обеспечивает универсальность, единообразие представления информации и удобство обработки машин и восприятия человеком.];
        [OSTIS-система состоит из базы знаний, решения проблем и пользовательского интерфейса, описываемых SC-кодом.];
    };
=> nrel_advantages:
    {
        [Любая модель решения проблем или знания может быть легко интегрирована в любую систему OSTIS по принципу plug & play.];
        [Компоненты OSTIS-систем универсальны и совместимы друг с другом, что позволяет накапливать библиотеку повторно используемых компонентов.];
        [Описание системы с помощью SC-кода дает ей рефлексивность: способность анализировать себя, находить ошибки и оптимизировать работу.];
        [OSTIS позволяет создавать платформенно-независимые системы и поддерживает разработку семантических компьютеров.];
        [OSTIS ориентирован на параллельную обработку информации благодаря многоагентной архитектуре.];
    };
=> nrel_key_takeaways:
    {
        [OSTIS — это технология для разработки интеллектуальных систем, а не конкретная система или универсальный метод решения задач любого класса.];
        [Основное преимущество OSTIS заключается в легкости модификации, развития и адаптации систем к новым задачам.];
        [OSTIS решает проблему совместимости интеллектуальных систем и снижает трудоемкость разработки новых решений.];
    };
<= nrel_inclusion: concept_sc_code_topic;;
