concept_sc_code
<- topic_basics_of_formalization;
=> nrel_main_idtf:
    [SC-код]
    (*
        <- lang_ru;;
    *);
=> nrel_definition:
    [SC-код (Semantic Computer Code) — это универсальный формальный язык унифицированного смыслового представления знаний в памяти ostis-систем.]
    (*
        <- concept_definition;;
        <- lang_ru;;
    *);
=> nrel_explanation:
    [SC-код используется для формализации знаний в ostis-системах, обеспечивая единый способ представления информации и ее взаимосвязей, что позволяет эффективно обрабатывать и использовать эти знания.]
    (*
        <- concept_explanation;;
        <- lang_ru;;
    *);;

concept_basic_concepts
<= nrel_inclusion: concept_sc_code;
=> nrel_main_idtf:
    [Основные понятия SC-кода]
    (*
        <- lang_ru;;
    *);
-> sc_element
    (*
        => nrel_main_idtf:
            [sc-элемент]
            (*
                <- lang_ru;;
            *);;
        => nrel_definition:
            [sc-элемент — это базовая единица SC-кода, которая может быть узлом, дугой или множеством, используемая для построения сложных конструкций знаний.]
            (*
                <- concept_definition;;
                <- lang_ru;;
            *);;
        => nrel_explanation:
            [Принято считать, что sc-элемент — это sc-обозначение множества, представимого в SC-коде, то есть sc-множества. То есть каждый sc-элемент является обозначением соответствующего множества.]
            (*
                <- concept_explanation;;
                <- lang_ru;;
            *);;
    *);
-> sc_construction
(*
    => nrel_main_idtf:
        [sc-конструкция]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [sc-конструкция — это знаковая конструкция, принадлежащая SC-коду;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [sc-конструкция представляет собой формальную синтаксическую единицу SC-кода, используемую для описания знаний и их структуры.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> sc_set
(*
    => nrel_main_idtf:
        [sc-множество]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [sc-множество — это множество sc-элементов;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [sc-множество является базовой структурой SC-кода, в которой могут объединяться sc-элементы, sc-связки, sc-классы и sc-структуры.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> sc_structure
(*
    => nrel_main_idtf:
        [sc-структура]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [sc-структура — это sc-множество, содержащее связки между элементами этого множества;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [sc-структура описывает взаимосвязи между элементами, образуя семантически значимое объединение узлов и связей.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> sc_text
(*
    => nrel_main_idtf:
        [sc-текст]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [sc-текст — это связная sc-структура, являющаяся семантически корректной в рамках SC-кода;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [sc-текст представляет собой целостное знание, описанное в виде связной структуры SC-кода и соответствующее правилам формальной модели.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> sc_knowledge
(*
    => nrel_main_idtf:
        [sc-знание]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [sc-знание — это sc-текст, обладающий свойствами знания;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [sc-знание — это формализованная информация, представленная SC-кодом и готовая к использованию в ostis-системе.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> sc_file
(*
    => nrel_main_idtf:
        [файл]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [файл — информационная конструкция, которая не является sc-конструкцией и которая может храниться в файловой памяти ostis-системы;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [файл является внешней сущностью, используемой для хранения данных, не представленных непосредственно в виде SC-кода.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> sc_idtf
(*
    => nrel_main_idtf:
        [sc-идентификатор]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [sc-идентификатор — файл, являющийся внешним идентификатором (в частности, именем) соответствующего sc-элемента, хранимого в памяти ostis-системы;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [sc-идентификатор связывает внешний файл с соответствующим элементом SC-кода, обеспечивая его однозначную идентификацию.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);
-> main_sc_idtf
(*
    => nrel_main_idtf:
        [основной sc-идентификатор]
        (*
            <- lang_ru;;
        *);;
    => nrel_definition:
        [основной sc-идентификатор — sc-идентификатор, который взаимно однозначно соответствует идентифицируемому sc-элементу;]
        (*
            <- concept_definition;;
            <- lang_ru;;
        *);;
    => nrel_explanation:
        [основной sc-идентификатор является основным именем элемента и используется для однозначной ссылки на него.]
        (*
            <- concept_explanation;;
            <- lang_ru;;
        *);;
*);;